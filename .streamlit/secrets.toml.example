# Copy to .streamlit/secrets.toml (gitignored) and fill in the values from your
# Cognito user pool's app client. Without this file, the app refuses to start
# unless AUTH_DISABLED=1 (local single-user mode).

[auth]
# Must exactly match a callback URL registered on the Cognito app client.
# Local:  http://localhost:8501/oauth2callback
# Server: https://<your-host>/oauth2callback
redirect_uri = "http://localhost:8501/oauth2callback"
# Any long random string; signs the login cookie. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
cookie_secret = "change-me"
client_id = "your-cognito-app-client-id"
client_secret = "your-cognito-app-client-secret"
server_metadata_url = "https://cognito-idp.<region>.amazonaws.com/<user-pool-id>/.well-known/openid-configuration"
# The app passes the ID token to the API, which verifies it (financial_rag/auth.py)
expose_tokens = "id"
