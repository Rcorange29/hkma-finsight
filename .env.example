OPENAI_API_KEY=sk-your-key-here

# Usage limits (see README "Usage limits"); 0 turns one off
# QUESTIONS_PER_MONTH=50
# UPLOADS_PER_MONTH=3
# QUESTIONS_PER_MINUTE=5
# QUESTIONS_PER_DAY_ALL_USERS=500

# Model for every language-model call (see config.py); compare with eval_answers.py
# CHAT_MODEL=gpt-4o-mini

# Login: the API verifies each request's Cognito ID token against these.
# Same pool and app client as .streamlit/secrets.toml; neither is a secret.
# COGNITO_ISSUER=https://cognito-idp.<region>.amazonaws.com/<user-pool-id>
# COGNITO_CLIENT_ID=<app-client-id>

# SEC EDGAR: required to check figures against the SEC's XBRL data. The SEC asks
# every automated request to say who is asking: "<app name> <your email>".
# SEC_USER_AGENT=financial-rag you@example.com

# Tracing (tracing.py): send each question's spans to an OTLP/HTTP collector, such as
# the Jaeger in compose.yaml (`docker compose --profile tracing up -d`). Off when unset.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
# TRACE_CONSOLE=1                     # or print spans to the log instead
