# ---------------------------------------------------------------------------
# Language model (the answer step)
#
# Ingestion and retrieval are fully local (BGE embeddings + a cross-encoder),
# so they need no API key. Only the final answer / summarisation calls a chat
# model. The default provider is Doubao (Volcano Ark, OpenAI-compatible).
# ---------------------------------------------------------------------------

# Doubao / Volcano Ark. Create an API key at:
#   https://console.volcengine.com/ark/region:ark+cn-beijing/apikey
# CHAT_MODEL may be a model id (e.g. doubao-seed-2-1-pro-260628) or an
# inference endpoint id (ep-xxxxxxxx). ARK_BASE_URL is pre-set; override it
# only if you use a different Ark region.
ARK_API_KEY=your-ark-key-here
# LLM_PROVIDER=doubao
# CHAT_MODEL=doubao-seed-2-1-pro-260628
# ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# OpenAI is still supported as an alternative. Set LLM_PROVIDER=openai and
# OPENAI_API_KEY (optionally OPENAI_BASE_URL for another OpenAI-compatible host).
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-your-key-here
# CHAT_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------------
# Embeddings
#
# Default: a local BGE sentence-transformer (free, offline). Downloaded on
# first run from Hugging Face; set HF_ENDPOINT=https://hf-mirror.com if your
# network can't reach huggingface.co.
# Local BGE is 384-dim; OpenAI text-embedding-3-small is 1536-dim. Switching
# EMBEDDING_PROVIDER requires rebuilding chroma_db (delete it and re-ingest).
# ---------------------------------------------------------------------------
# EMBEDDING_PROVIDER=local
# LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# HF_ENDPOINT=https://hf-mirror.com
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-3-small

# Retrieval (see rag.py). Local BGE defaults to 0.35; OpenAI to 0.10.
# SCORE_THRESHOLD=0.35
# Cross-encoder refusal floor (raw logit): below -2.0 the best passage is
# treated as irrelevant and the question is refused (exact-value matches exempt).
# RERANK_SCORE_FLOOR=-2.0
# RERANKER=cross-encoder      # cross-encoder (local) or llm (extra model call)

# Usage limits (see README "Usage limits"); 0 turns one off
# QUESTIONS_PER_MONTH=50
# UPLOADS_PER_MONTH=3
# QUESTIONS_PER_MINUTE=5
# QUESTIONS_PER_DAY_ALL_USERS=500

# Model for every language-model call (see config.py); compare with eval_answers.py
# CHAT_MODEL=gpt-4o-mini

# Login: the API verifies each request's Cognito ID token against these.
# Same pool and app client as .streamlit/secrets.toml; neither is a secret.
# COGNITO_ISSUER=https://cognito-idp.<region>.amazonaws.com/<user-pool-id>
# COGNITO_CLIENT_ID=<app-client-id>

# SEC EDGAR: required to check figures against the SEC's XBRL data (10-K only).
# The SEC asks every automated request to say who is asking: "<app name> <email>".
# SEC_USER_AGENT=financial-rag you@example.com

# Tracing (tracing.py): send each question's spans to an OTLP/HTTP collector, such as
# the Jaeger in compose.yaml (`docker compose --profile tracing up -d`). Off when unset.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
# TRACE_CONSOLE=1                     # or print spans to the log instead
